# YURIAN AI OS environment contract
# Never commit real secrets. Keep provider credentials server-side.

NODE_ENV=development
APP_NAME=YURIAN_AI_OS
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PREFIX=api/v1

DATABASE_URL=postgresql://yurian:change-me@localhost:5432/yurian_ai_os
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=replace-with-long-random-secret
JWT_REFRESH_SECRET=replace-with-different-long-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# AI provider: claude | openai | gemini | local | custom
AI_DEFAULT_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# Object storage
STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# OAuth providers. Secrets remain backend-only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Security / limits
CORS_ORIGINS=http://localhost:3000
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
MAX_UPLOAD_BYTES=52428800
AI_MAX_COST_USD_PER_RUN=1
AI_MAX_TOOL_CALLS_PER_RUN=20
AI_MAX_RUN_DURATION_MS=120000

# Observability
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
