NODE_ENV=production
APP_NAME=YURIAN_AI_OS
APP_URL=https://app.example.com
API_URL=https://api.example.com
API_PREFIX=api/v1

POSTGRES_DB=yurian_ai_os
POSTGRES_USER=yurian
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
DATABASE_URL=postgresql://yurian:CHANGE_ME_TO_A_LONG_RANDOM_SECRET@postgres:5432/yurian_ai_os
REDIS_URL=redis://redis:6379

JWT_ACCESS_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_REFRESH_SECRET=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_SECRET
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

AI_DEFAULT_PROVIDER=claude
CLAUDE_API_KEY=
CLAUDE_MODEL=

STORAGE_PROVIDER=s3
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

CORS_ORIGINS=https://app.example.com
RATE_LIMIT_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=120
MAX_UPLOAD_BYTES=52428800
AI_MAX_COST_USD_PER_RUN=1
AI_MAX_TOOL_CALLS_PER_RUN=20
AI_MAX_RUN_DURATION_MS=120000

LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=

APP_DOMAIN=app.example.com
API_DOMAIN=api.example.com
