generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MembershipRole { OWNER ADMIN MANAGER MEMBER VIEWER DEVELOPER }
enum ConversationRole { USER ASSISTANT SYSTEM TOOL }
enum MemoryType { USER WORKSPACE PROJECT BUSINESS CONVERSATION SEMANTIC EPISODIC }
enum ToolRiskLevel { LOW MEDIUM HIGH CRITICAL }
enum ApprovalStatus { PENDING APPROVED REJECTED EXPIRED CANCELLED }
enum AgentRunStatus { PENDING RUNNING WAITING_APPROVAL COMPLETED FAILED CANCELLED }
enum TaskStatus { TODO IN_PROGRESS DONE CANCELLED }

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String?
  name String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  conversations Conversation[]
  memories Memory[]
  sessions Session[]
}

model Session {
  id String @id @default(cuid())
  userId String
  refreshTokenHash String @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastUsedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Organization {
  id String @id @default(cuid())
  name String
  slug String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
  workspaces Workspace[]
  projects Project[]
  tasks Task[]
  memories Memory[]
  auditLogs AuditLog[]
}

model Membership {
  id String @id @default(cuid())
  organizationId String
  userId String
  role MembershipRole
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([organizationId, userId])
  @@index([userId])
}

model Workspace {
  id String @id @default(cuid())
  organizationId String
  name String
  slug String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projects Project[]
  tasks Task[]
  conversations Conversation[]
  memories Memory[]
  documents Document[]
  agents Agent[]
  approvals Approval[]
  auditLogs AuditLog[]
  @@unique([organizationId, slug])
  @@index([organizationId])
}

model Project {
  id String @id @default(cuid())
  organizationId String
  workspaceId String
  name String
  description String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  tasks Task[]
  @@index([organizationId, workspaceId])
}

model Task {
  id String @id @default(cuid())
  organizationId String
  workspaceId String
  projectId String?
  title String
  description String?
  status TaskStatus @default(TODO)
  completed Boolean @default(false)
  dueAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  @@index([organizationId, workspaceId, status])
  @@index([workspaceId, dueAt])
}

model Conversation {
  id String @id @default(cuid())
  userId String
  workspaceId String
  title String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  messages Message[]
  @@index([workspaceId, updatedAt])
}

model Message {
  id String @id @default(cuid())
  conversationId String
  role ConversationRole
  content String
  createdAt DateTime @default(now())
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model Memory {
  id String @id @default(cuid())
  organizationId String
  workspaceId String?
  userId String?
  type MemoryType
  content String
  source String?
  confidence Float @default(0.5)
  importance Float @default(0.5)
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([organizationId, workspaceId, type])
  @@index([userId, type])
}

model Document {
  id String @id @default(cuid())
  workspaceId String
  name String
  mimeType String
  storageKey String
  sizeBytes BigInt
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  chunks DocumentChunk[]
  @@index([workspaceId, createdAt])
}

model DocumentChunk {
  id String @id @default(cuid())
  documentId String
  chunkIndex Int
  content String
  metadata Json?
  embedding Unsupported("vector")?
  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, chunkIndex])
}

model Agent {
  id String @id @default(cuid())
  workspaceId String
  name String
  description String?
  instructions String
  model String
  tools Json @default("[]")
  permissions Json @default("[]")
  memoryConfig Json @default("{}")
  approvalPolicy Json @default("{}")
  limits Json @default("{}")
  status String @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs AgentRun[]
  @@index([workspaceId, status])
}

model AgentRun {
  id String @id @default(cuid())
  agentId String
  workspaceId String
  status AgentRunStatus @default(PENDING)
  input Json
  output Json?
  traceId String @unique
  error String?
  startedAt DateTime?
  finishedAt DateTime?
  createdAt DateTime @default(now())
  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  @@index([workspaceId, createdAt])
}

model Tool {
  id String @id @default(cuid())
  name String @unique
  description String
  schema Json
  riskLevel ToolRiskLevel
  permissions Json @default("[]")
  enabled Boolean @default(true)
  createdAt DateTime @default(now())
}

model Approval {
  id String @id @default(cuid())
  workspaceId String
  agentId String?
  userId String
  requestedAction String
  riskLevel ToolRiskLevel
  payload Json
  explanation String
  status ApprovalStatus @default(PENDING)
  expiresAt DateTime?
  approvedBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@index([workspaceId, status, createdAt])
}

model AuditLog {
  id String @id @default(cuid())
  organizationId String
  workspaceId String?
  userId String?
  action String
  resourceType String
  resourceId String?
  traceId String?
  metadata Json?
  createdAt DateTime @default(now())
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  @@index([organizationId, createdAt])
  @@index([workspaceId, createdAt])
  @@index([traceId])
}
